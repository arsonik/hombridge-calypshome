{
  "compilerOptions": {
    "baseUrl": ".",
    "target": "es2022",
    "module": "commonjs",
    "moduleResolution": "Node",
    "lib": [
      "esnext","dom"
    ],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "noImplicitAny": true
  },
  "include": [
    "src/"
  ],
  "exclude": [
    "**/*.spec.ts"
  ]
}
